@page "/"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Inicio | AFRISAN</PageTitle>

<div class="container-fluid py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102c46, #176b91);">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1 class="fw-bold mb-2">AFRISAN</h1>

                <p class="mb-0">
                    Sistema de gestión de cilindros y gases refrigerantes
                </p>
            </div>

            @if (esAdministrador)
            {
                <span class="badge bg-light text-dark p-3">
                    Panel de administración
                </span>
            }
            else if (esJefatura)
            {
                <span class="badge bg-light text-dark p-3">
                    Panel de supervisión
                </span>
            }
            else if (esBodega)
            {
                <span class="badge bg-light text-dark p-3">
                    Panel de bodega
                </span>
            }
            else if (esTecnico)
            {
                <span class="badge bg-light text-dark p-3">
                    Panel técnico
                </span>
            }

        </div>

    </div>

    <!-- =====================================================
         BIENVENIDA SEGÚN ROL
         ===================================================== -->

    <div class="mb-4">

        <h3 class="fw-bold">Panel principal</h3>

        @if (esAdministrador)
        {
            <p class="text-muted">
                Bienvenido al panel de administración de AFRISAN.
                Desde aquí puedes supervisar el sistema y acceder
                a sus principales módulos.
            </p>
        }
        else if (esJefatura)
        {
            <p class="text-muted">
                Bienvenido al panel de supervisión de AFRISAN.
                Desde aquí puedes consultar información general
                del inventario y realizar seguimiento de la operación.
            </p>
        }
        else if (esBodega)
        {
            <p class="text-muted">
                Bienvenido al área de bodega de AFRISAN.
                Desde aquí puedes gestionar cilindros, refrigerantes
                y operaciones asociadas al inventario.
            </p>
        }
        else if (esTecnico)
        {
            <p class="text-muted">
                Bienvenido al área técnica de AFRISAN.
                Desde aquí puedes identificar cilindros y acceder
                a las funciones relacionadas con trabajo en terreno.
            </p>
        }

    </div>

    <!-- =====================================================
         ERROR
         ===================================================== -->

    @if (error is not null)
    {
        <div class="alert alert-danger mb-4"
             role="alert">

            <strong>Error de conexión:</strong>
            @error

            <p class="mb-0 mt-2">
                Comprueba que Afrisan.Api esté ejecutándose.
            </p>

        </div>
    }

    <!-- =====================================================
         RESUMEN DE INVENTARIO
         ADMINISTRADOR / JEFATURA / BODEGA
         ===================================================== -->

    @if (esAdministrador || esJefatura || esBodega)
    {
        <div class="row g-3 mb-4">

            <!-- TOTAL -->
            <div class="col-12 col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100 rounded-4">

                    <div class="card-body p-4">

                        <h6 class="text-muted">
                            Total de cilindros
                        </h6>

                        <h2 class="fw-bold text-primary">
                            @TotalCilindros
                        </h2>

                        <small class="text-muted">
                            Cilindros registrados en el sistema
                        </small>

                    </div>

                </div>

            </div>

            <!-- DISPONIBLES -->
            <div class="col-12 col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100 rounded-4">

                    <div class="card-body p-4">

                        <h6 class="text-muted">
                            Cilindros disponibles
                        </h6>

                        <h2 class="fw-bold text-success">
                            @CilindrosDisponibles
                        </h2>

                        <small class="text-muted">
                            Cilindros disponibles para utilizar
                        </small>

                    </div>

                </div>

            </div>

            <!-- EN USO -->
            <div class="col-12 col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100 rounded-4">

                    <div class="card-body p-4">

                        <h6 class="text-muted">
                            Cilindros en uso
                        </h6>

                        <h2 class="fw-bold text-warning">
                            @CilindrosEnUso
                        </h2>

                        <small class="text-muted">
                            Cilindros utilizados actualmente
                        </small>

                    </div>

                </div>

            </div>

            <!-- GASES -->
            <div class="col-12 col-md-6 col-xl-3">

                <div class="card border-0 shadow-sm h-100 rounded-4">

                    <div class="card-body p-4">

                        <h6 class="text-muted">
                            Tipos de gases refrigerantes
                        </h6>

                        <h2 class="fw-bold text-info">
                            @TotalGases
                        </h2>

                        <small class="text-muted">
                            Gases registrados en el sistema
                        </small>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         ADMINISTRADOR
         ===================================================== -->

    @if (esAdministrador)
    {
        <h4 class="fw-bold mb-3">
            Módulos de administración
        </h4>

        <div class="row g-3">

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📦</h2>

                        <h5 class="fw-bold">
                            Gestión de cilindros
                        </h5>

                        <p class="text-muted">
                            Administra los cilindros registrados
                            y consulta su disponibilidad.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">❄️</h2>

                        <h5 class="fw-bold">
                            Gases refrigerantes
                        </h5>

                        <p class="text-muted">
                            Administra el catálogo de refrigerantes
                            utilizados por AFRISAN.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">👥</h2>

                        <h5 class="fw-bold">
                            Gestión de usuarios
                        </h5>

                        <p class="text-muted">
                            Crea usuarios, asigna roles
                            y administra sus accesos.
                        </p>

                        <span class="badge bg-secondary">
                            En desarrollo
                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         BODEGA
         ===================================================== -->

    @if (esBodega)
    {
        <h4 class="fw-bold mb-3">
            Operaciones de bodega
        </h4>

        <div class="row g-3">

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📦</h2>

                        <h5 class="fw-bold">
                            Gestión de cilindros
                        </h5>

                        <p class="text-muted">
                            Consulta cilindros y realiza
                            operaciones asociadas a bodega.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">❄️</h2>

                        <h5 class="fw-bold">
                            Gases refrigerantes
                        </h5>

                        <p class="text-muted">
                            Consulta los refrigerantes
                            asociados a los cilindros.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6 col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📱</h2>

                        <h5 class="fw-bold">
                            Identificación QR
                        </h5>

                        <p class="text-muted">
                            Identifica cilindros mediante
                            su código QR.
                        </p>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         JEFATURA
         ===================================================== -->

    @if (esJefatura)
    {
        <h4 class="fw-bold mb-3">
            Supervisión
        </h4>

        <div class="row g-3">

            <div class="col-12 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📊</h2>

                        <h5 class="fw-bold">
                            Supervisión operacional
                        </h5>

                        <p class="text-muted">
                            Consulta el estado general
                            de cilindros y refrigerantes.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📈</h2>

                        <h5 class="fw-bold">
                            Dashboard e indicadores
                        </h5>

                        <p class="text-muted">
                            Visualización de indicadores
                            y emisiones GEI.
                        </p>

                        <span class="badge bg-secondary">
                            Próximo desarrollo
                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         TÉCNICO
         ===================================================== -->

    @if (esTecnico)
    {
        <h4 class="fw-bold mb-3">
            Trabajo en terreno
        </h4>

        <div class="row g-3">

            <div class="col-12 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">📱</h2>

                        <h5 class="fw-bold">
                            Identificación QR
                        </h5>

                        <p class="text-muted">
                            Identifica un cilindro mediante
                            su código QR y consulta
                            su información.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-12 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h2 class="mb-3">🛠️</h2>

                        <h5 class="fw-bold">
                            Intervenciones en terreno
                        </h5>

                        <p class="text-muted">
                            Registro de intervenciones,
                            cargas y fallas en terreno.
                        </p>

                        <span class="badge bg-secondary">
                            Próximo desarrollo
                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =====================================================
         PIE DE PÁGINA
         ===================================================== -->

    <div class="text-center mt-5 pt-3 border-top">

        <small class="text-muted">
            AFRISAN | Sistema de gestión de refrigerantes
        </small>

    </div>

</div>

@code {

    private bool esAdministrador;
    private bool esJefatura;
    private bool esBodega;
    private bool esTecnico;

    private List<CilindroResumen> cilindros = new();

    private List<GasResumen> gases = new();

    private bool cargando = true;

    private string? error;

    private string TotalCilindros =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count.ToString();

    private string CilindrosDisponibles =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count(c =>
            string.Equals(
                c.Estado?.Trim(),
                "Disponible",
                StringComparison.OrdinalIgnoreCase
            )
        ).ToString();

    private string CilindrosEnUso =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count(c =>
            string.Equals(
                c.Estado?.Trim(),
                "En uso",
                StringComparison.OrdinalIgnoreCase
            ) ||
            string.Equals(
                c.Estado?.Trim(),
                "Despachado",
                StringComparison.OrdinalIgnoreCase
            )
        ).ToString();

    private string TotalGases =>
        cargando ? "..." :
        error is not null ? "--" :
        gases.Count.ToString();

    protected override async Task OnInitializedAsync()
    {
        var estado =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        var usuario =
            estado.User;

        esAdministrador =
            usuario.IsInRole("Administrador");

        esJefatura =
            usuario.IsInRole("Jefatura");

        esBodega =
            usuario.IsInRole("Bodega");

        esTecnico =
            usuario.IsInRole("Tecnico");

        // El técnico no necesita consultar
        // todo el inventario desde este panel.
        if (esTecnico)
        {
            cargando = false;
            return;
        }

        cargando = true;
        error = null;

        try
        {
            cilindros =
                await Http.GetFromJsonAsync<
                    List<CilindroResumen>>(
                    "api/Cilindros"
                ) ?? new();

            gases =
                await Http.GetFromJsonAsync<
                    List<GasResumen>>(
                    "api/GasRefrigerantes"
                ) ?? new();
        }
        catch (Exception ex)
        {
            error =
                "No se pudieron obtener los datos del sistema.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private sealed class CilindroResumen
    {
        public int Id { get; set; }

        public string Estado { get; set; }
            = string.Empty;
    }

    private sealed class GasResumen
    {
        public int Id { get; set; }
    }
}