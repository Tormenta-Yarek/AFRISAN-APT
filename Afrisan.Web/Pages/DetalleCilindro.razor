@page "/cilindros/detalle/{CodigoQr}"

@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Administrador,Jefatura,Bodega,Tecnico")]

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Detalle del cilindro | AFRISAN</PageTitle>

<div class="container-fluid py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102c46, #176b91);">

        <h1 class="fw-bold mb-2">
            Detalle del cilindro
        </h1>

        @if (esTecnico)
        {
            <p class="mb-0">
                Consulta la información y el historial de movimientos
                del cilindro identificado mediante QR.
            </p>
        }
        else
        {
            <p class="mb-0">
                Consulta la información, historial de movimientos
                y balance de masa de un cilindro registrado en AFRISAN.
            </p>
        }

    </div>


    <!-- =====================================================
         VOLVER
         ===================================================== -->

    <div class="mb-4">

        <a class="btn btn-outline-secondary"
           href="identificacion-qr">

            ← Volver a Identificación QR

        </a>

    </div>


    <!-- =====================================================
         CARGANDO
         ===================================================== -->

    @if (cargando)
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-5 text-center">

                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <p class="text-muted mt-3 mb-0">
                    Cargando información del cilindro...
                </p>

            </div>

        </div>
    }


    <!-- =====================================================
         ERROR GENERAL
         ===================================================== -->

    @if (!cargando && error is not null)
    {
        <div class="alert alert-danger"
             role="alert">

            <h5 class="fw-bold">
                No se pudo mostrar el cilindro
            </h5>

            <p class="mb-3">
                @error
            </p>

            <button class="btn btn-outline-danger"
                    @onclick="CargarDetalle">

                Intentar nuevamente

            </button>

        </div>
    }


    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    @if (!cargando &&
         error is null &&
         cilindro is not null)
    {
        <!-- =================================================
             INFORMACIÓN GENERAL
             ================================================= -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <div class="d-flex justify-content-between
                            align-items-center
                            flex-wrap
                            gap-3">

                    <div>

                        <h4 class="fw-bold mb-1">
                            @cilindro.CodigoQr
                        </h4>

                        <p class="text-muted mb-0">
                            Información del cilindro registrado en AFRISAN
                        </p>

                    </div>

                    <div>

                        @if (string.Equals(
                            cilindro.Estado,
                            "Disponible",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success fs-6">
                                Disponible
                            </span>
                        }
                        else if (
                            string.Equals(
                                cilindro.Estado,
                                "Despachado",
                                StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(
                                cilindro.Estado,
                                "En uso",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                @cilindro.Estado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @cilindro.Estado
                            </span>
                        }

                    </div>

                </div>

            </div>


            <div class="card-body p-4">

                <h5 class="fw-bold mb-3">
                    Información general
                </h5>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <tbody>

                            <tr>

                                <th style="width: 35%;">
                                    ID del cilindro
                                </th>

                                <td>
                                    @cilindro.Id
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Código QR
                                </th>

                                <td>
                                    <strong>
                                        @cilindro.CodigoQr
                                    </strong>
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Gas refrigerante
                                </th>

                                <td>
                                    @(cilindro.GasRefrigerante?.Nombre
                                        ?? cilindro.TipoRefrigerante)
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Capacidad
                                </th>

                                <td>
                                    @(cilindro.CapacidadKg.ToString("0.##")) kg
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Tara
                                </th>

                                <td>

                                    @if (cilindro.TaraKg.HasValue)
                                    {
                                        <span>
                                            @(cilindro.TaraKg.Value.ToString("0.##")) kg
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No registrada
                                        </span>
                                    }

                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Peso actual
                                </th>

                                <td>
                                    @(cilindro.PesoActualKg.ToString("0.##")) kg
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Estado
                                </th>

                                <td>
                                    @cilindro.Estado
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <div class="d-flex justify-content-end mt-4">

                    <button class="btn btn-primary"
                            disabled="@cargando"
                            @onclick="CargarDetalle">

                        Actualizar información

                    </button>

                </div>

            </div>

        </div>


        <!-- =================================================
             HISTORIAL
             TODOS LOS ROLES
             ================================================= -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <h5 class="fw-bold mb-1">
                    Historial de movimientos
                </h5>

                <p class="text-muted mb-0">
                    Consulta los despachos y retornos registrados
                    para este cilindro.
                </p>

            </div>


            <div class="card-body p-4">

                @if (errorHistorial is not null)
                {
                    <div class="alert alert-warning mb-0">

                        <strong>
                            No se pudo cargar el historial.
                        </strong>

                        <p class="mb-0 mt-2">
                            @errorHistorial
                        </p>

                    </div>
                }
                else if (
                    historial is null ||
                    historial.Movimientos.Count == 0)
                {
                    <div class="alert alert-info mb-0">

                        Este cilindro todavía no tiene movimientos
                        de inventario registrados.

                    </div>
                }
                else
                {
                    <p class="mb-3">

                        <strong>
                            Total de movimientos:
                        </strong>

                        @historial.TotalMovimientos

                    </p>


                    <div class="table-responsive">

                        <table class="table
                                      table-striped
                                      table-bordered
                                      align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Movimiento
                                    </th>

                                    <th>
                                        Orden de Trabajo
                                    </th>

                                    <th>
                                        Peso
                                    </th>

                                    <th>
                                        Responsable
                                    </th>

                                    <th>
                                        Fecha y hora
                                    </th>

                                    <th>
                                        Observaciones
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var movimiento in historial.Movimientos)
                                {
                                    <tr>

                                        <td>

                                            @if (string.Equals(
                                                movimiento.TipoMovimiento,
                                                "Despacho",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge
                                                             bg-warning
                                                             text-dark">

                                                    Despacho

                                                </span>
                                            }
                                            else if (string.Equals(
                                                movimiento.TipoMovimiento,
                                                "Retorno",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-success">

                                                    Retorno

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">

                                                    @movimiento.TipoMovimiento

                                                </span>
                                            }

                                        </td>


                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(
                                                movimiento.OrdenTrabajo))
                                            {
                                                <span class="badge bg-primary">

                                                    @movimiento.OrdenTrabajo

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    No aplica
                                                </span>
                                            }

                                        </td>


                                        <td>
                                            @(movimiento.PesoKg.ToString("0.##")) kg
                                        </td>


                                        <td>
                                            @movimiento.Responsable
                                        </td>


                                        <td>
                                            @(movimiento.FechaMovimiento
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm"))
                                        </td>


                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                movimiento.Observaciones)
                                                ? "Sin observaciones"
                                                : movimiento.Observaciones)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <small class="text-muted">

                        Las fechas se muestran según
                        la hora local del dispositivo.

                    </small>
                }

            </div>

        </div>


        <!-- =================================================
             BALANCE DE MASA
             ADMIN / JEFATURA / BODEGA
             ================================================= -->

        @if (!esTecnico)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white p-4">

                    <h5 class="fw-bold mb-1">
                        Balance de masa
                    </h5>

                    <p class="text-muted mb-0">

                        Compara el peso registrado al despacho
                        con el peso registrado al retorno
                        del cilindro.

                    </p>

                </div>


                <div class="card-body p-4">

                    @if (errorBalance is not null)
                    {
                        <div class="alert alert-info mb-0">

                            <strong>
                                Balance todavía no disponible.
                            </strong>

                            <p class="mb-0 mt-2">
                                @errorBalance
                            </p>

                        </div>
                    }
                    else if (balance is null)
                    {
                        <div class="alert alert-info mb-0">

                            No existe información suficiente para
                            calcular el balance de masa.

                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-4">

                            <!-- PESO DESPACHO -->

                            <div class="col-12 col-md-4">

                                <div class="border rounded-4 p-3 h-100">

                                    <small class="text-muted">
                                        Peso al despacho
                                    </small>

                                    <h4 class="fw-bold mt-2 mb-1">
                                        @(balance.PesoDespachoKg.ToString("0.##")) kg
                                    </h4>

                                    <small class="text-muted">

                                        @(balance.FechaDespacho
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))

                                    </small>

                                </div>

                            </div>


                            <!-- PESO RETORNO -->

                            <div class="col-12 col-md-4">

                                <div class="border rounded-4 p-3 h-100">

                                    <small class="text-muted">
                                        Peso al retorno
                                    </small>

                                    <h4 class="fw-bold mt-2 mb-1">
                                        @(balance.PesoRetornoKg.ToString("0.##")) kg
                                    </h4>

                                    <small class="text-muted">

                                        @(balance.FechaRetorno
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))

                                    </small>

                                </div>

                            </div>


                            <!-- DIFERENCIA -->

                            <div class="col-12 col-md-4">

                                <div class="border rounded-4 p-3 h-100">

                                    <small class="text-muted">

                                        @(balance.BalanceValido
                                            ? "Refrigerante utilizado"
                                            : "Diferencia registrada")

                                    </small>

                                    <h4 class="fw-bold mt-2 mb-1">
                                        @(balance.DiferenciaKg.ToString("0.##")) kg
                                    </h4>

                                    <small class="text-muted">
                                        Despacho − retorno
                                    </small>

                                </div>

                            </div>

                        </div>


                        @if (balance.BalanceValido)
                        {
                            <div class="alert alert-success mb-0">

                                <strong>
                                    ✓ Balance de masa correcto
                                </strong>

                                <p class="mb-0 mt-2">

                                    El peso de retorno es igual
                                    o menor que el peso registrado
                                    al despacho.

                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0">

                                <strong>
                                    ⚠ Inconsistencia en el balance de masa
                                </strong>

                                <p class="mb-0 mt-2">

                                    El peso registrado al retorno
                                    es mayor que el peso registrado
                                    al despacho.

                                    Revisa los datos ingresados.

                                </p>

                            </div>
                        }
                    }

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-light border">

                <strong>
                    Vista técnica
                </strong>

                <p class="mb-0 mt-2 text-muted">

                    El usuario Técnico puede consultar
                    la identificación y el historial del cilindro.

                </p>

            </div>
        }
    }


    <!-- =====================================================
         PIE
         ===================================================== -->

    <div class="text-center mt-5 pt-3 border-top">

        <small class="text-muted">

            AFRISAN | Sistema de gestión de refrigerantes

        </small>

    </div>

</div>


@code {

    // =====================================================
    // PARÁMETRO DE RUTA
    // =====================================================

    [Parameter]
    public string CodigoQr { get; set; } =
        string.Empty;


    // =====================================================
    // ROLES
    // =====================================================

    private bool esTecnico;


    // =====================================================
    // DATOS
    // =====================================================

    private CilindroVista? cilindro;

    private HistorialVista? historial;

    private BalanceMasaVista? balance;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool cargando = true;

    private string? error;

    private string? errorHistorial;

    private string? errorBalance;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnParametersSetAsync()
    {
        var estado =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        esTecnico =
            estado.User.IsInRole(
                "Tecnico");

        await CargarDetalle();
    }


    // =====================================================
    // CARGAR DETALLE
    // =====================================================

    private async Task CargarDetalle()
    {
        cargando = true;

        error = null;

        errorHistorial = null;

        errorBalance = null;

        cilindro = null;

        historial = null;

        balance = null;


        try
        {
            // -------------------------------------------------
            // VALIDAR CÓDIGO QR
            // -------------------------------------------------

            if (string.IsNullOrWhiteSpace(
                CodigoQr))
            {
                error =
                    "No se recibió un código de cilindro.";

                return;
            }


            var codigoNormalizado =
                CodigoQr
                    .Trim()
                    .ToUpperInvariant();


            var codigoSeguro =
                Uri.EscapeDataString(
                    codigoNormalizado);


            // =================================================
            // CONSULTAR UN ÚNICO CILINDRO POR QR
            // =================================================

            using var respuestaCilindro =
                await Http.GetAsync(
                    $"api/Cilindros/qr/{codigoSeguro}"
                );


            if (!respuestaCilindro.IsSuccessStatusCode)
            {
                if (respuestaCilindro.StatusCode ==
                    HttpStatusCode.NotFound)
                {
                    error =
                        await ObtenerMensajeApi(
                            respuestaCilindro,
                            $"No se encontró un cilindro con " +
                            $"el código '{codigoNormalizado}'."
                        );

                    return;
                }


                if (respuestaCilindro.StatusCode ==
                    HttpStatusCode.Forbidden)
                {
                    error =
                        "Tu usuario no tiene permiso para " +
                        "consultar este cilindro.";

                    return;
                }


                if (respuestaCilindro.StatusCode ==
                    HttpStatusCode.Unauthorized)
                {
                    error =
                        "La sesión no es válida o ha expirado. " +
                        "Vuelve a iniciar sesión.";

                    return;
                }


                error =
                    await ObtenerMensajeApi(
                        respuestaCilindro,
                        "No se pudo consultar el cilindro."
                    );

                return;
            }


            cilindro =
                await respuestaCilindro.Content
                    .ReadFromJsonAsync<CilindroVista>();


            if (cilindro is null)
            {
                error =
                    "La API no devolvió información del cilindro.";

                return;
            }


            // =================================================
            // HISTORIAL
            // TODOS LOS ROLES
            // =================================================

            try
            {
                using var respuestaHistorial =
                    await Http.GetAsync(
                        $"api/MovimientosInventario/" +
                        $"historial/{cilindro.Id}"
                    );


                if (respuestaHistorial.IsSuccessStatusCode)
                {
                    historial =
                        await respuestaHistorial.Content
                            .ReadFromJsonAsync<HistorialVista>();


                    if (historial is null)
                    {
                        errorHistorial =
                            "La API no devolvió información " +
                            "del historial.";
                    }
                }
                else
                {
                    errorHistorial =
                        await ObtenerMensajeApi(
                            respuestaHistorial,
                            "No se pudo cargar el historial " +
                            "de movimientos."
                        );
                }
            }
            catch (Exception ex)
            {
                errorHistorial =
                    "No se pudo cargar el historial " +
                    "de movimientos.";

                Console.WriteLine(ex);
            }


            // =================================================
            // BALANCE
            // ADMIN / JEFATURA / BODEGA
            // =================================================

            if (!esTecnico)
            {
                try
                {
                    using var respuestaBalance =
                        await Http.GetAsync(
                            $"api/MovimientosInventario/" +
                            $"balance/{cilindro.Id}"
                        );


                    if (respuestaBalance.IsSuccessStatusCode)
                    {
                        balance =
                            await respuestaBalance.Content
                                .ReadFromJsonAsync<BalanceMasaVista>();


                        if (balance is null)
                        {
                            errorBalance =
                                "La API no devolvió información " +
                                "del balance.";
                        }
                    }
                    else
                    {
                        errorBalance =
                            await ObtenerMensajeApi(
                                respuestaBalance,
                                "No existe información suficiente " +
                                "para calcular el balance."
                            );
                    }
                }
                catch (Exception ex)
                {
                    errorBalance =
                        "No se pudo consultar el balance de masa.";

                    Console.WriteLine(ex);
                }
            }
        }
        catch (Exception ex)
        {
            error =
                "Ocurrió un error al consultar el cilindro. " +
                "Comprueba que Afrisan.Api esté ejecutándose.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // LEER MENSAJE DE ERROR DE LA API
    // =====================================================

    private async Task<string> ObtenerMensajeApi(
        HttpResponseMessage respuesta,
        string mensajePredeterminado)
    {
        try
        {
            var mensajeApi =
                await respuesta.Content
                    .ReadFromJsonAsync<MensajeApiVista>();

            if (!string.IsNullOrWhiteSpace(
                mensajeApi?.Mensaje))
            {
                return mensajeApi.Mensaje;
            }
        }
        catch
        {
            // Si la API no entrega JSON legible,
            // usamos el mensaje predeterminado.
        }

        return mensajePredeterminado;
    }


    // =====================================================
    // MODELO CILINDRO
    // =====================================================

    private sealed class CilindroVista
    {
        public int Id { get; set; }

        public string CodigoQr { get; set; } =
            string.Empty;

        public string TipoRefrigerante { get; set; } =
            string.Empty;

        public decimal CapacidadKg { get; set; }

        public decimal? TaraKg { get; set; }

        public decimal PesoActualKg { get; set; }

        public string Estado { get; set; } =
            string.Empty;

        public DateTime FechaRegistro { get; set; }

        public int? GasRefrigeranteId { get; set; }

        public GasRefrigeranteVista? GasRefrigerante
        {
            get;
            set;
        }
    }


    // =====================================================
    // MODELO GAS
    // =====================================================

    private sealed class GasRefrigeranteVista
    {
        public int Id { get; set; }

        public string Nombre { get; set; } =
            string.Empty;

        public string Codigo { get; set; } =
            string.Empty;

        public string Descripcion { get; set; } =
            string.Empty;

        public bool Activo { get; set; }
    }


    // =====================================================
    // MODELO HISTORIAL
    // =====================================================

    private sealed class HistorialVista
    {
        public int CilindroId { get; set; }

        public string CodigoQr { get; set; } =
            string.Empty;

        public string EstadoActual { get; set; } =
            string.Empty;

        public int TotalMovimientos { get; set; }

        public List<MovimientoVista> Movimientos
        {
            get;
            set;
        } = new();
    }


    // =====================================================
    // MODELO MOVIMIENTO
    // =====================================================

    private sealed class MovimientoVista
    {
        public int Id { get; set; }

        public string TipoMovimiento { get; set; } =
            string.Empty;

        public int? OrdenTrabajoId { get; set; }

        public string? OrdenTrabajo { get; set; }

        public decimal PesoKg { get; set; }

        public string Responsable { get; set; } =
            string.Empty;

        public DateTime FechaMovimiento { get; set; }

        public string? Observaciones { get; set; }
    }


    // =====================================================
    // MODELO BALANCE
    // =====================================================

    private sealed class BalanceMasaVista
    {
        public int CilindroId { get; set; }

        public string CodigoQr { get; set; } =
            string.Empty;

        public int DespachoId { get; set; }

        public int? OrdenTrabajoId { get; set; }

        public decimal PesoDespachoKg { get; set; }

        public DateTime FechaDespacho { get; set; }

        public int RetornoId { get; set; }

        public decimal PesoRetornoKg { get; set; }

        public DateTime FechaRetorno { get; set; }

        public decimal DiferenciaKg { get; set; }

        public bool BalanceValido { get; set; }

        public string EstadoBalance { get; set; } =
            string.Empty;
    }


    // =====================================================
    // MENSAJE API
    // =====================================================

    private sealed class MensajeApiVista
    {
        public string Mensaje { get; set; } =
            string.Empty;
    }
}