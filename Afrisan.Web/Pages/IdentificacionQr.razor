@page "/identificacion-qr"

@using System.Net.Http.Json
@using QRCoder
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Administrador,Jefatura,Bodega,Tecnico")]

@inject HttpClient Http
@inject NavigationManager Navegacion
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Identificación QR | AFRISAN</PageTitle>

<div class="container-fluid py-4">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102c46, #176b91);">

        <h1 class="fw-bold mb-2">
            Identificación QR
        </h1>

        @if (esTecnico)
        {
            <p class="mb-0">
                Identifica un cilindro mediante su código QR
                y consulta su información.
            </p>
        }
        else
        {
            <p class="mb-0">
                Genera y visualiza los códigos QR de los cilindros
                registrados en AFRISAN.
            </p>
        }

    </div>


    <!-- =====================================================
         MENSAJE DE ERROR
         ===================================================== -->

    @if (error is not null)
    {
        <div class="alert alert-danger"
             role="alert">

            @error

        </div>
    }


    <!-- =====================================================
         VISTA DEL TÉCNICO
         NO CARGA TODO EL INVENTARIO
         ===================================================== -->

    @if (esTecnico)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <h4 class="fw-bold mb-1">
                    Identificar cilindro
                </h4>

                <p class="text-muted mb-0">
                    Ingresa el código del cilindro indicado
                    en su etiqueta QR.
                </p>

            </div>

            <div class="card-body p-4">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-8">

                        <label class="form-label fw-bold">
                            Código QR del cilindro
                        </label>

                        <input type="text"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ejemplo: CIL-0003"
                               @bind="codigoBusqueda"
                               @onkeydown="ProcesarTecla" />

                        <small class="text-muted">
                            Ingresa exactamente el código asociado
                            al cilindro.
                        </small>

                    </div>

                    <div class="col-12 col-md-4">

                        <button type="button"
                                class="btn btn-primary w-100"
                                @onclick="AbrirFichaPorCodigo">

                            Consultar cilindro

                        </button>

                    </div>

                </div>

            </div>

        </div>

        <div class="alert alert-info">

            <strong>Uso en terreno:</strong>

            al escanear el QR del cilindro,
            AFRISAN abrirá directamente su ficha
            para consultar la información registrada.

        </div>
    }


    <!-- =====================================================
         VISTA ADMINISTRADOR / BODEGA / JEFATURA
         ===================================================== -->

    @if (!esTecnico)
    {
        <!-- CARGANDO CILINDROS -->

        @if (cargando)
        {
            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <p class="text-muted mt-3">
                    Cargando cilindros...
                </p>

            </div>
        }


        <!-- SIN CILINDROS -->

        @if (!cargando &&
             error is null &&
             cilindros.Count == 0)
        {
            <div class="alert alert-info">

                No existen cilindros registrados
                para generar códigos QR.

            </div>
        }


        <!-- LISTADO DE CILINDROS -->

        @if (!cargando &&
             error is null &&
             cilindros.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-header bg-white p-4">

                    <h4 class="fw-bold mb-1">
                        Seleccionar cilindro
                    </h4>

                    <p class="text-muted mb-0">
                        Presiona «Ver QR» para generar el código
                        del cilindro seleccionado.
                    </p>

                </div>

                <div class="card-body p-4">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>ID</th>
                                    <th>Código QR</th>
                                    <th>Gas refrigerante</th>
                                    <th>Estado</th>
                                    <th>Acción</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var cilindro in cilindros)
                                {
                                    <tr>

                                        <td>
                                            @cilindro.Id
                                        </td>

                                        <td>

                                            <strong>
                                                @cilindro.CodigoQr
                                            </strong>

                                        </td>

                                        <td>

                                            @(cilindro.GasRefrigerante?.Nombre
                                                ?? cilindro.TipoRefrigerante)

                                        </td>

                                        <td>

                                            @if (string.Equals(
                                                cilindro.Estado,
                                                "Disponible",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-success">
                                                    Disponible
                                                </span>
                                            }
                                            else if (
                                                string.Equals(
                                                    cilindro.Estado,
                                                    "Despachado",
                                                    StringComparison.OrdinalIgnoreCase) ||
                                                string.Equals(
                                                    cilindro.Estado,
                                                    "En uso",
                                                    StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-warning text-dark">

                                                    @cilindro.Estado

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">

                                                    @cilindro.Estado

                                                </span>
                                            }

                                        </td>

                                        <td>

                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    @onclick="() => MostrarQr(cilindro)">

                                                Ver QR

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }


        <!-- =====================================================
             QR GENERADO
             ===================================================== -->

        @if (cilindroSeleccionado is not null &&
             codigoQrSvg is not null &&
             enlaceDetalle is not null)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white p-4">

                    <h4 class="fw-bold mb-1">
                        Código QR del cilindro
                    </h4>

                    <p class="text-muted mb-0">
                        @cilindroSeleccionado.CodigoQr
                    </p>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4 align-items-center">

                        <!-- IMAGEN QR -->

                        <div class="col-12 col-md-5 text-center">

                            <div class="bg-white
                                        border
                                        rounded-4
                                        p-4
                                        d-inline-block"
                                 style="max-width: 100%;">

                                @((MarkupString)codigoQrSvg)

                            </div>

                            <p class="fw-bold mt-3 mb-1">

                                @cilindroSeleccionado.CodigoQr

                            </p>

                            <small class="text-muted d-block mb-3">

                                Escanea el código con la cámara
                                de tu celular.

                            </small>

                            <a class="btn btn-outline-primary"
                               href="@enlaceDetalle">

                                Abrir ficha del cilindro

                            </a>

                        </div>


                        <!-- INFORMACIÓN -->

                        <div class="col-12 col-md-7">

                            <h5 class="fw-bold mb-3">
                                Información del cilindro
                            </h5>

                            <table class="table">

                                <tbody>

                                    <tr>

                                        <th>ID</th>

                                        <td>
                                            @cilindroSeleccionado.Id
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Código QR</th>

                                        <td>
                                            @cilindroSeleccionado.CodigoQr
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Gas refrigerante</th>

                                        <td>

                                            @(cilindroSeleccionado
                                                .GasRefrigerante?.Nombre
                                                ?? cilindroSeleccionado
                                                    .TipoRefrigerante)

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Capacidad</th>

                                        <td>

                                            @cilindroSeleccionado
                                                .CapacidadKg
                                                .ToString("0.##") kg

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Peso actual</th>

                                        <td>

                                            @cilindroSeleccionado
                                                .PesoActualKg
                                                .ToString("0.##") kg

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>Estado</th>

                                        <td>
                                            @cilindroSeleccionado.Estado
                                        </td>

                                    </tr>

                                </tbody>

                            </table>


                            <!-- ENLACE GUARDADO -->

                            <div class="alert alert-info mb-0">

                                <strong>
                                    Enlace guardado en el código QR:
                                </strong>

                                <p class="mt-2 mb-2 text-break">
                                    @enlaceDetalle
                                </p>

                                <small>

                                    Durante el desarrollo local,
                                    el enlace utiliza la dirección
                                    donde se está ejecutando AFRISAN.

                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }
    }


    <!-- =====================================================
         PIE DE PÁGINA
         ===================================================== -->

    <div class="text-center mt-5 pt-3 border-top">

        <small class="text-muted">

            AFRISAN | Sistema de gestión de refrigerantes

        </small>

    </div>

</div>


@code {

    // =====================================================
    // ROLES
    // =====================================================

    private bool esTecnico;


    // =====================================================
    // DATOS
    // =====================================================

    private List<CilindroVista> cilindros =
        new();

    private CilindroVista? cilindroSeleccionado;

    private string? codigoQrSvg;

    private string? enlaceDetalle;

    private string codigoBusqueda =
        string.Empty;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool cargando = true;

    private string? error;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        var estado =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        esTecnico =
            estado.User.IsInRole(
                "Tecnico");

        // El Técnico no necesita descargar
        // el inventario completo.
        if (esTecnico)
        {
            cargando = false;

            return;
        }

        await CargarCilindros();
    }


    // =====================================================
    // CARGAR CILINDROS
    // ADMIN / BODEGA / JEFATURA
    // =====================================================

    private async Task CargarCilindros()
    {
        if (esTecnico)
        {
            return;
        }

        cargando = true;

        error = null;

        try
        {
            cilindros =
                await Http.GetFromJsonAsync<
                    List<CilindroVista>>(
                    "api/Cilindros"
                ) ?? new();
        }
        catch (Exception ex)
        {
            cilindros =
                new();

            error =
                "No se pudieron cargar los cilindros. " +
                "Comprueba que Afrisan.Api esté ejecutándose.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // TÉCNICO:
    // ABRIR FICHA MEDIANTE CÓDIGO
    // =====================================================

    private void AbrirFichaPorCodigo()
    {
        error = null;

        var codigo =
            codigoBusqueda?.Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            error =
                "Debes ingresar el código del cilindro.";

            return;
        }

        var codigoSeguro =
            Uri.EscapeDataString(
                codigo);

        Navegacion.NavigateTo(
            $"cilindros/detalle/{codigoSeguro}"
        );
    }


    // =====================================================
    // ENTER EN EL CAMPO DE BÚSQUEDA
    // =====================================================

    private void ProcesarTecla(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AbrirFichaPorCodigo();
        }
    }


    // =====================================================
    // GENERAR QR
    // ADMIN / BODEGA / JEFATURA
    // =====================================================

    private void MostrarQr(
        CilindroVista cilindro)
    {
        if (esTecnico)
        {
            return;
        }

        codigoQrSvg =
            null;

        cilindroSeleccionado =
            null;

        enlaceDetalle =
            null;


        if (string.IsNullOrWhiteSpace(
            cilindro.CodigoQr))
        {
            error =
                "El cilindro seleccionado no tiene un código QR.";

            return;
        }

        try
        {
            error = null;


            string codigo =
                Uri.EscapeDataString(
                    cilindro.CodigoQr.Trim());


            string direccionFicha =
                Navegacion.ToAbsoluteUri(
                    $"cilindros/detalle/{codigo}"
                ).AbsoluteUri;


            using var generador =
                new QRCodeGenerator();


            using var datosQr =
                generador.CreateQrCode(
                    direccionFicha,
                    QRCodeGenerator.ECCLevel.Q
                );


            using var codigoQr =
                new SvgQRCode(
                    datosQr);


            codigoQrSvg =
                codigoQr.GetGraphic(6);


            enlaceDetalle =
                direccionFicha;


            cilindroSeleccionado =
                cilindro;
        }
        catch (Exception ex)
        {
            codigoQrSvg =
                null;

            enlaceDetalle =
                null;

            cilindroSeleccionado =
                null;

            error =
                "No se pudo generar el código QR del cilindro.";

            Console.WriteLine(ex);
        }
    }


    // =====================================================
    // MODELO CILINDRO
    // =====================================================

    private sealed class CilindroVista
    {
        public int Id { get; set; }

        public string CodigoQr { get; set; } =
            string.Empty;

        public string TipoRefrigerante { get; set; } =
            string.Empty;

        public decimal CapacidadKg { get; set; }

        public decimal PesoActualKg { get; set; }

        public string Estado { get; set; } =
            string.Empty;

        public GasRefrigeranteVista?
            GasRefrigerante
        {
            get;
            set;
        }
    }


    // =====================================================
    // MODELO GAS
    // =====================================================

    private sealed class GasRefrigeranteVista
    {
        public string Nombre { get; set; } =
            string.Empty;
    }
}