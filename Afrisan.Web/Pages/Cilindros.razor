@page "/cilindros"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Gestión de cilindros | AFRISAN</PageTitle>

<div class="container-fluid py-4">

    <!-- ENCABEZADO -->
    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #102c46, #176b91);">

        <h1 class="fw-bold mb-2">
            Gestión de cilindros
        </h1>

        <p class="mb-0">
            Registra y administra cilindros, despachos y retornos
            de gases refrigerantes de AFRISAN.
        </p>

    </div>


    <!-- RESUMEN -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Total de cilindros
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @TotalCilindros
                    </h2>

                    <small class="text-muted">
                        Cilindros registrados en el sistema
                    </small>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Cilindros disponibles
                    </h6>

                    <h2 class="fw-bold text-success">
                        @CilindrosDisponibles
                    </h2>

                    <small class="text-muted">
                        Cilindros disponibles para utilizar
                    </small>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h6 class="text-muted">
                        Cilindros despachados o en uso
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @CilindrosEnUso
                    </h2>

                    <small class="text-muted">
                        Cilindros que no están disponibles en bodega
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- MENSAJES -->
    @if (mensajeExito is not null)
    {
        <div class="alert alert-success mb-4" role="status">
            @mensajeExito
        </div>
    }

    @if (errorOperacion is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">
            @errorOperacion
        </div>
    }


    <!-- FORMULARIO REGISTRO / EDICIÓN -->
    @if (mostrarFormulario)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <h4 class="fw-bold mb-1">
                    @(idEditando.HasValue
                        ? "Editar cilindro"
                        : "Registrar nuevo cilindro")
                </h4>

                <p class="text-muted mb-0">
                    @(idEditando.HasValue
                        ? "Modifica los datos técnicos permitidos."
                        : "Completa los datos. AFRISAN generará el código automáticamente.")
                </p>

            </div>


            <div class="card-body p-4">

                @if (errorFormulario is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @errorFormulario
                    </div>
                }

                @if (cargandoGases)
                {
                    <div class="text-center py-4">

                        <div class="spinner-border text-primary"
                             role="status">
                        </div>

                        <p class="mt-2">
                            Cargando gases refrigerantes...
                        </p>

                    </div>
                }
                else
                {
                    <div class="row g-3">

                        <!-- CÓDIGO -->
                        <div class="col-12 col-md-6">

                            <label class="form-label fw-bold">
                                Código del cilindro
                            </label>

                            @if (idEditando.HasValue)
                            {
                                <input type="text"
                                       class="form-control"
                                       value="@formulario.CodigoQr"
                                       disabled />

                                <small class="text-muted">
                                    Este código no se puede modificar.
                                </small>
                            }
                            else
                            {
                                <input type="text"
                                       class="form-control"
                                       value="Se generará automáticamente"
                                       disabled />

                                <small class="text-muted">
                                    AFRISAN asignará un código como
                                    CIL-0001, CIL-0002 o CIL-0003.
                                </small>
                            }

                        </div>


                        <!-- GAS -->
                        <div class="col-12 col-md-6">

                            <label class="form-label fw-bold">
                                Gas refrigerante *
                            </label>

                            <select class="form-select"
                                    @bind="formulario.GasRefrigeranteId"
                                    disabled="@guardando">

                                <option value="">
                                    Selecciona un refrigerante
                                </option>

                                @foreach (var gas in gases.Where(g => g.Activo))
                                {
                                    <option value="@gas.Id">
                                        @gas.Nombre (@gas.Codigo)
                                    </option>
                                }

                            </select>

                            <small class="text-muted d-block mt-1">
                                Solo puedes elegir un gas del catálogo.
                            </small>

                        </div>


                        <!-- CAPACIDAD -->
                        <div class="col-12 col-md-4">

                            <label class="form-label fw-bold">
                                Capacidad refrigerante (kg) *
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0.01"
                                   max="1000000"
                                   step="0.01"
                                   @bind="formulario.CapacidadKg"
                                   disabled="@guardando" />

                            <small class="text-muted">
                                Capacidad máxima de refrigerante.
                            </small>

                        </div>


                        <!-- TARA -->
                        <div class="col-12 col-md-4">

                            <label class="form-label fw-bold">
                                Tara del cilindro (kg) *
                            </label>

                            <input type="number"
                                   class="form-control"
                                   min="0.01"
                                   max="1000000"
                                   step="0.01"
                                   @bind="formulario.TaraKg"
                                   disabled="@guardando" />

                            <small class="text-muted">
                                Peso del cilindro completamente vacío.
                            </small>

                        </div>


                        <!-- PESO BRUTO ACTUAL -->
                        <div class="col-12 col-md-4">

                            <label class="form-label fw-bold">
                                Peso bruto actual (kg) *
                            </label>

                            @if (idEditando.HasValue)
                            {
                                <input type="text"
                                       class="form-control"
                                       value="@($"{formulario.PesoActualKg:0.##} kg")"
                                       disabled />

                                <small class="text-muted">
                                    El peso actual solo cambia mediante
                                    operaciones de inventario.
                                </small>
                            }
                            else
                            {
                                <input type="number"
                                       class="form-control"
                                       min="0"
                                       max="1000000"
                                       step="0.01"
                                       @bind="formulario.PesoActualKg"
                                       disabled="@guardando" />

                                <small class="text-muted">
                                    Peso total medido: cilindro + refrigerante.
                                </small>
                            }

                        </div>


                        <!-- ESTADO -->
                        <div class="col-12 col-md-6">

                            <label class="form-label fw-bold">
                                Estado del cilindro
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@(idEditando.HasValue
                                                                   ? formulario.Estado
                                                                   : "Disponible")"
                                   disabled />

                            <small class="text-muted">
                                El estado se administra automáticamente.
                            </small>

                        </div>

                    </div>


                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@guardando"
                                @onclick="CancelarFormulario">
                            Cancelar
                        </button>

                        <button type="button"
                                class="btn btn-success"
                                disabled="@(guardando || cargandoGases || !gases.Any(g => g.Activo))"
                                @onclick="GuardarCilindro">

                            @(guardando
                                ? "Guardando..."
                                : idEditando.HasValue
                                    ? "Guardar cambios"
                                    : "Registrar cilindro")

                        </button>

                    </div>
                }

            </div>

        </div>
    }


    <!-- FORMULARIO DESPACHO / RETORNO -->
    @if (cilindroOperacion is not null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-header bg-white p-4">

                <h4 class="fw-bold mb-1">
                    @(esRetorno
                        ? "Registrar retorno del cilindro"
                        : "Registrar despacho del cilindro")
                </h4>

                <p class="text-muted mb-0">
                    Código QR:
                    <strong>@cilindroOperacion.CodigoQr</strong>
                </p>

            </div>

            <div class="card-body p-4">

                @if (errorMovimiento is not null)
                {
                    <div class="alert alert-danger">
                        @errorMovimiento
                    </div>
                }

                <div class="alert alert-info">

                    @if (esRetorno)
                    {
                        <span>
                            Registra el peso bruto medido cuando el cilindro
                            regresa a bodega.
                        </span>
                    }
                    else
                    {
                        <span>
                            Registra el peso bruto medido antes de que el
                            cilindro salga de bodega.
                        </span>
                    }

                </div>


                <div class="row g-3">

                    @if (!esRetorno)
                    {
                        <!-- ORDEN DE TRABAJO -->
                        <div class="col-12">

                            <label class="form-label fw-bold">
                                Orden de Trabajo *
                            </label>

                            <select class="form-select"
                                    @bind="formularioMovimiento.OrdenTrabajoId"
                                    disabled="@procesandoMovimiento">

                                <option value="">
                                    Selecciona una Orden de Trabajo
                                </option>

                                @foreach (var orden in ordenesTrabajo.Where(o => o.Activa))
                                {
                                    <option value="@orden.Id">
                                        @orden.Codigo
                                        @if (!string.IsNullOrWhiteSpace(orden.Descripcion))
                                        {
                                            <text> - @orden.Descripcion</text>
                                        }
                                    </option>
                                }

                            </select>

                            <small class="text-muted d-block mt-1">
                                Solo puedes despachar un cilindro asociado
                                a una Orden de Trabajo activa.
                            </small>

                        </div>
                    }

                    <!-- RESPONSABLE -->
                    <div class="col-12 col-md-6">

                        <label class="form-label fw-bold">
                            Responsable *
                        </label>

                        <input type="text"
                               class="form-control"
                               maxlength="150"
                               placeholder="Nombre de la persona responsable"
                               @bind="formularioMovimiento.Responsable"
                               disabled="@procesandoMovimiento" />

                    </div>


                    <!-- PESO -->
                    <div class="col-12 col-md-6">

                        <label class="form-label fw-bold">
                            @(esRetorno
                                ? "Peso de retorno (kg) *"
                                : "Peso bruto de despacho (kg) *")
                        </label>

                        <input type="number"
                               class="form-control"
                               min="0"
                               step="0.01"
                               placeholder="Ingresa el peso medido"
                               @bind="formularioMovimiento.PesoKg"
                               disabled="@procesandoMovimiento" />

                        <small class="text-muted d-block mt-1">
                            Peso actual:
                            @cilindroOperacion.PesoActualKg.ToString("0.##") kg
                        </small>

                        <small class="text-muted d-block">
                            Tara:
                            @(cilindroOperacion.TaraKg.HasValue
                                ? $"{cilindroOperacion.TaraKg.Value:0.##} kg"
                                : "Sin registrar")
                        </small>

                        @if (!esRetorno && cilindroOperacion.TaraKg.HasValue)
                        {
                            <small class="text-primary d-block mt-1">
                                Para despachar, el peso bruto debe ser mayor
                                que @cilindroOperacion.TaraKg.Value.ToString("0.##") kg.
                            </small>
                        }

                    </div>


                    <!-- OBSERVACIONES -->
                    <div class="col-12">

                        <label class="form-label fw-bold">
                            Observaciones
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Observaciones del movimiento"
                                  @bind="formularioMovimiento.Observaciones"
                                  disabled="@procesandoMovimiento">
                        </textarea>

                    </div>

                </div>


                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@procesandoMovimiento"
                            @onclick="CancelarMovimiento">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn @(esRetorno ? "btn-success" : "btn-warning")"
                            disabled="@(procesandoMovimiento ||
                                                                (!esRetorno &&
                                                                 !formularioMovimiento.OrdenTrabajoId.HasValue))"
                            @onclick="GuardarMovimiento">

                        @(procesandoMovimiento
                            ? "Guardando movimiento..."
                            : esRetorno
                                ? "Confirmar retorno"
                                : "Confirmar despacho")

                    </button>

                </div>

            </div>

        </div>
    }


    <!-- INVENTARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h4 class="fw-bold mb-1">
                        Inventario de cilindros
                    </h4>

                    <p class="text-muted mb-0">
                        Consulta y administra los cilindros registrados.
                    </p>

                </div>


                <div class="d-flex gap-2 flex-wrap">

                    <button class="btn btn-success"
                            disabled="@(mostrarFormulario || cilindroOperacion is not null || Ocupado)"
                            @onclick="AbrirFormularioNuevo">
                        + Registrar cilindro
                    </button>

                    <button class="btn btn-primary"
                            disabled="@Ocupado"
                            @onclick="CargarCilindros">
                        Actualizar listado
                    </button>

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            @if (cargando)
            {
                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">
                    </div>

                    <p class="mt-3 text-muted">
                        Cargando cilindros...
                    </p>

                </div>
            }


            @if (!cargando && error is not null)
            {
                <div class="alert alert-danger">

                    <strong>
                        No se pudieron cargar los cilindros.
                    </strong>

                    <p class="mb-0 mt-2">
                        @error
                    </p>

                </div>
            }


            @if (!cargando && error is null && cilindros.Count == 0)
            {
                <div class="alert alert-info">
                    No existen cilindros registrados.
                </div>
            }


            @if (!cargando && error is null && cilindros.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Código QR</th>
                                <th>Gas refrigerante</th>
                                <th>Capacidad</th>
                                <th>Tara</th>
                                <th>Peso actual</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var cilindro in cilindros)
                            {
                                <tr>

                                    <td>
                                        @cilindro.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @cilindro.CodigoQr
                                        </strong>
                                    </td>

                                    <td>
                                        @(cilindro.GasRefrigerante?.Nombre
                                            ?? cilindro.TipoRefrigerante)
                                    </td>

                                    <td>
                                        @cilindro.CapacidadKg.ToString("0.##") kg
                                    </td>

                                    <td>

                                        @if (cilindro.TaraKg.HasValue)
                                        {
                                            @($"{cilindro.TaraKg.Value:0.##} kg")
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Sin registrar
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @cilindro.PesoActualKg.ToString("0.##") kg
                                    </td>

                                    <td>

                                        @if (EsEstado(cilindro.Estado, "Disponible"))
                                        {
                                            <span class="badge bg-success">
                                                Disponible
                                            </span>
                                        }
                                        else if (EsEstado(cilindro.Estado, "Despachado"))
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Despachado
                                            </span>
                                        }
                                        else if (EsEstado(cilindro.Estado, "En uso"))
                                        {
                                            <span class="badge bg-warning text-dark">
                                                En uso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @cilindro.Estado
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="d-flex gap-2 flex-wrap">

                                            @if (EsEstado(cilindro.Estado, "Disponible"))
                                            {
                                                <button class="btn btn-sm btn-warning"
                                                        disabled="@(mostrarFormulario || cilindroOperacion is not null || Ocupado)"
                                                        @onclick="() => AbrirMovimiento(cilindro, false)">
                                                    Despachar
                                                </button>
                                            }

                                            @if (EsEstado(cilindro.Estado, "Despachado"))
                                            {
                                                <button class="btn btn-sm btn-success"
                                                        disabled="@(mostrarFormulario || cilindroOperacion is not null || Ocupado)"
                                                        @onclick="() => AbrirMovimiento(cilindro, true)">
                                                    Registrar retorno
                                                </button>
                                            }

                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="@($"cilindros/detalle/{Uri.EscapeDataString(cilindro.CodigoQr.Trim())}")">
                                                Ver ficha
                                            </a>

                                            <button class="btn btn-sm btn-outline-primary"
                                                    disabled="@(mostrarFormulario || cilindroOperacion is not null || Ocupado)"
                                                    @onclick="() => AbrirFormularioEdicion(cilindro)">
                                                Editar
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(mostrarFormulario || cilindroOperacion is not null || Ocupado)"
                                                    @onclick="() => SolicitarEliminacion(cilindro.Id)">
                                                Eliminar
                                            </button>

                                        </div>

                                    </td>

                                </tr>


                                @if (idPorEliminar == cilindro.Id)
                                {
                                    <tr>

                                        <td colspan="8">

                                            <div class="alert alert-warning mb-0">

                                                <strong>
                                                    ¿Eliminar el cilindro
                                                    @cilindro.CodigoQr?
                                                </strong>

                                                <p class="mb-3 mt-2">
                                                    Los cilindros con movimientos
                                                    asociados no pueden eliminarse.
                                                </p>

                                                <div class="d-flex gap-2">

                                                    <button class="btn btn-danger btn-sm"
                                                            disabled="@Ocupado"
                                                            @onclick="() => EliminarCilindro(cilindro.Id)">
                                                        Confirmar eliminación
                                                    </button>

                                                    <button class="btn btn-secondary btn-sm"
                                                            disabled="@Ocupado"
                                                            @onclick="CancelarEliminacion">
                                                        Cancelar
                                                    </button>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <div class="text-center mt-5 pt-3 border-top">

        <small class="text-muted">
            AFRISAN | Sistema de gestión de refrigerantes
        </small>

    </div>

</div>


@code {

    // =====================================================
    // DATOS
    // =====================================================

    private List<CilindroVista> cilindros = new();

    private List<GasRefrigeranteVista> gases = new();

    private List<OrdenTrabajoVista> ordenesTrabajo = new();

    private FormularioCilindro formulario = new();

    private FormularioMovimiento formularioMovimiento = new();

    private CilindroVista? cilindroOperacion;


    // =====================================================
    // ESTADOS
    // =====================================================

    private bool cargando = true;

    private bool cargandoGases;

    private bool cargandoOrdenesTrabajo;

    private bool guardando;

    private bool mostrarFormulario;

    private bool procesandoMovimiento;

    private bool esRetorno;

    private int? idEditando;

    private int? idPorEliminar;

    private int? idEliminando;

    private string? error;

    private string? errorFormulario;

    private string? errorOperacion;

    private string? errorMovimiento;

    private string? mensajeExito;


    private bool Ocupado =>
        cargando ||
        cargandoGases ||
        cargandoOrdenesTrabajo ||
        guardando ||
        procesandoMovimiento ||
        idEliminando.HasValue;


    // =====================================================
    // CONTADORES
    // =====================================================

    private string TotalCilindros =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count.ToString();


    private string CilindrosDisponibles =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count(c =>
            EsEstado(c.Estado, "Disponible")
        ).ToString();


    private string CilindrosEnUso =>
        cargando ? "..." :
        error is not null ? "--" :
        cilindros.Count(c =>
            EsEstado(c.Estado, "En uso") ||
            EsEstado(c.Estado, "Despachado")
        ).ToString();


    private static bool EsEstado(
        string? actual,
        string esperado)
    {
        return string.Equals(
            actual?.Trim(),
            esperado,
            StringComparison.OrdinalIgnoreCase
        );
    }


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarCilindros();
    }


    // =====================================================
    // CARGAR CILINDROS
    // =====================================================

    private async Task CargarCilindros()
    {
        cargando = true;

        error = null;

        try
        {
            cilindros =
                await Http.GetFromJsonAsync<List<CilindroVista>>(
                    "api/Cilindros"
                ) ?? new();
        }
        catch (Exception ex)
        {
            cilindros = new();

            error =
                "Comprueba que Afrisan.Api esté ejecutándose " +
                "y que la conexión con el servidor funcione.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // CARGAR GASES
    // =====================================================

    private async Task CargarGases()
    {
        cargandoGases = true;

        errorFormulario = null;

        try
        {
            gases =
                await Http.GetFromJsonAsync<List<GasRefrigeranteVista>>(
                    "api/GasRefrigerantes"
                ) ?? new();
        }
        catch (Exception ex)
        {
            gases = new();

            errorFormulario =
                "No se pudieron cargar los gases refrigerantes.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargandoGases = false;
        }
    }


    // =====================================================
    // CARGAR ÓRDENES DE TRABAJO ACTIVAS
    // =====================================================

    private async Task CargarOrdenesTrabajo()
    {
        cargandoOrdenesTrabajo = true;

        ordenesTrabajo = new();

        try
        {
            ordenesTrabajo =
                await Http.GetFromJsonAsync<List<OrdenTrabajoVista>>(
                    "api/OrdenesTrabajo/activas"
                ) ?? new();
        }
        catch (Exception ex)
        {
            ordenesTrabajo = new();

            errorOperacion =
                "No se pudieron cargar las Órdenes de Trabajo activas. " +
                "Comprueba la conexión con la API.";

            Console.WriteLine(ex);
        }
        finally
        {
            cargandoOrdenesTrabajo = false;
        }
    }


