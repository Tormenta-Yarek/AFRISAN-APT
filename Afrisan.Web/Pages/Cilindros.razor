    // =====================================================
    // CANCELAR
    // =====================================================

    private void CancelarFormulario()
    {
        if (guardando)
        {
            return;
        }

        mostrarFormulario = false;

        idEditando = null;

        errorFormulario = null;

        formulario =
            new FormularioCilindro();
    }


    // =====================================================
    // GUARDAR CILINDRO
    // =====================================================

    private async Task GuardarCilindro()
    {
        if (Ocupado || !mostrarFormulario)
        {
            return;
        }

        errorFormulario = null;

        errorOperacion = null;

        mensajeExito = null;


        // GAS
        if (!formulario.GasRefrigeranteId.HasValue)
        {
            errorFormulario =
                "Debes seleccionar un gas refrigerante.";

            return;
        }


        var gasSeleccionado =
            gases.FirstOrDefault(g =>
                g.Id ==
                formulario.GasRefrigeranteId.Value &&
                g.Activo
            );

        if (gasSeleccionado is null)
        {
            errorFormulario =
                "El gas seleccionado no existe o no está activo.";

            return;
        }


        // CAPACIDAD
        if (formulario.CapacidadKg <= 0 ||
            formulario.CapacidadKg > 1000000)
        {
            errorFormulario =
                "La capacidad debe ser mayor que cero " +
                "y no superar 1.000.000 kg.";

            return;
        }


        // TARA
        if (!formulario.TaraKg.HasValue ||
            formulario.TaraKg.Value <= 0 ||
            formulario.TaraKg.Value > 1000000)
        {
            errorFormulario =
                "Debes ingresar una tara válida mayor que cero.";

            return;
        }


        var tara =
            formulario.TaraKg.Value;


        // PESO BRUTO ACTUAL
        if (formulario.PesoActualKg < 0 ||
            formulario.PesoActualKg > 1000000)
        {
            errorFormulario =
                "El peso bruto actual debe estar entre " +
                "0 y 1.000.000 kg.";

            return;
        }


        if (formulario.PesoActualKg < tara)
        {
            errorFormulario =
                "El peso bruto actual no puede ser menor " +
                "que la tara del cilindro.";

            return;
        }


        var pesoBrutoMaximo =
            tara + formulario.CapacidadKg;


        if (formulario.PesoActualKg > pesoBrutoMaximo)
        {
            errorFormulario =
                $"El peso bruto actual no puede superar " +
                $"tara + capacidad ({pesoBrutoMaximo:0.##} kg).";

            return;
        }


        guardando = true;

        try
        {
            if (idEditando.HasValue)
            {
                var datosEdicion = new
                {
                    codigoQr =
                        formulario.CodigoQr,

                    tipoRefrigerante =
                        gasSeleccionado.Codigo,

                    capacidadKg =
                        formulario.CapacidadKg,

                    taraKg =
                        tara,

                    pesoActualKg =
                        formulario.PesoActualKg,

                    estado =
                        formulario.Estado,

                    gasRefrigeranteId =
                        formulario.GasRefrigeranteId.Value
                };


                using var respuesta =
                    await Http.PutAsJsonAsync(
                        $"api/Cilindros/{idEditando.Value}",
                        datosEdicion
                    );


                if (!respuesta.IsSuccessStatusCode)
                {
                    errorFormulario =
                        await LeerErrorApi(
                            respuesta,
                            "No se pudo actualizar el cilindro."
                        );

                    return;
                }


                mostrarFormulario = false;

                idEditando = null;

                formulario =
                    new FormularioCilindro();


                mensajeExito =
                    "El cilindro se actualizó correctamente.";
            }
            else
            {
                var datosRegistro = new
                {
                    gasRefrigeranteId =
                        formulario.GasRefrigeranteId.Value,

                    capacidadKg =
                        formulario.CapacidadKg,

                    taraKg =
                        tara,

                    pesoActualKg =
                        formulario.PesoActualKg
                };


                using var respuesta =
                    await Http.PostAsJsonAsync(
                        "api/Cilindros",
                        datosRegistro
                    );


                if (!respuesta.IsSuccessStatusCode)
                {
                    errorFormulario =
                        await LeerErrorApi(
                            respuesta,
                            "No se pudo registrar el cilindro."
                        );

                    return;
                }


                var cilindroCreado =
                    await respuesta.Content
                        .ReadFromJsonAsync<CilindroVista>();


                mostrarFormulario = false;

                idEditando = null;

                formulario =
                    new FormularioCilindro();


                mensajeExito =
                    cilindroCreado is not null &&
                    !string.IsNullOrWhiteSpace(
                        cilindroCreado.CodigoQr)
                        ? $"El cilindro {cilindroCreado.CodigoQr} " +
                          "se registró correctamente."
                        : "El cilindro se registró correctamente.";
            }


            await CargarCilindros();
        }
        catch (Exception ex)
        {
            errorFormulario =
                "Ocurrió un error al guardar el cilindro. " +
                "Comprueba la conexión con la API.";

            Console.WriteLine(ex);
        }
        finally
        {
            guardando = false;
        }
    }


    // =====================================================
    // ABRIR DESPACHO / RETORNO
    // =====================================================

    private async Task AbrirMovimiento(
        CilindroVista cilindro,
        bool retornar)
    {
        if (Ocupado ||
            mostrarFormulario ||
            cilindroOperacion is not null)
        {
            return;
        }


        if (retornar &&
            !EsEstado(
                cilindro.Estado,
                "Despachado"))
        {
            return;
        }


        if (!retornar &&
            !EsEstado(
                cilindro.Estado,
                "Disponible"))
        {
            return;
        }


        // NO PERMITIR DESPACHO SIN TARA
        if (!retornar &&
            (!cilindro.TaraKg.HasValue ||
             cilindro.TaraKg.Value <= 0))
        {
            errorOperacion =
                $"El cilindro {cilindro.CodigoQr} no tiene una tara registrada. " +
                "Debes editar el cilindro y registrar su tara antes de despacharlo.";

            return;
        }


        errorMovimiento = null;

        errorOperacion = null;

        mensajeExito = null;

        idPorEliminar = null;


        // PARA DESPACHAR DEBE EXISTIR AL MENOS UNA OT ACTIVA
        if (!retornar)
        {
            await CargarOrdenesTrabajo();

            if (errorOperacion is not null)
            {
                return;
            }

            if (!ordenesTrabajo.Any(o => o.Activa))
            {
                errorOperacion =
                    "No existen Órdenes de Trabajo activas. " +
                    "Debes crear una OT antes de despachar un cilindro.";

                return;
            }
        }


        cilindroOperacion =
            cilindro;

        esRetorno =
            retornar;

        formularioMovimiento =
            new FormularioMovimiento();
    }


    // =====================================================
    // CANCELAR MOVIMIENTO
    // =====================================================

    private void CancelarMovimiento()
    {
        if (procesandoMovimiento)
        {
            return;
        }

        cilindroOperacion = null;

        formularioMovimiento =
            new FormularioMovimiento();

        errorMovimiento = null;
    }


    // =====================================================
    // GUARDAR MOVIMIENTO
    // =====================================================

    private async Task GuardarMovimiento()
    {
        if (procesandoMovimiento ||
            cilindroOperacion is null)
        {
            return;
        }


        errorMovimiento = null;

        errorOperacion = null;

        mensajeExito = null;


        // RESPONSABLE
        if (string.IsNullOrWhiteSpace(
            formularioMovimiento.Responsable))
        {
            errorMovimiento =
                "Debes ingresar el nombre del responsable.";

            return;
        }


        // PESO
        if (!formularioMovimiento.PesoKg.HasValue ||
            formularioMovimiento.PesoKg.Value < 0)
        {
            errorMovimiento =
                "Debes ingresar un peso válido.";

            return;
        }


        var pesoMovimiento =
            formularioMovimiento.PesoKg.Value;


        // VALIDACIÓN DE DESPACHO
        if (!esRetorno)
        {
            if (!formularioMovimiento.OrdenTrabajoId.HasValue)
            {
                errorMovimiento =
                    "Debes seleccionar una Orden de Trabajo.";

                return;
            }


            var ordenSeleccionada =
                ordenesTrabajo.FirstOrDefault(o =>
                    o.Id == formularioMovimiento.OrdenTrabajoId.Value &&
                    o.Activa
                );

            if (ordenSeleccionada is null)
            {
                errorMovimiento =
                    "La Orden de Trabajo seleccionada no existe " +
                    "o ya no se encuentra activa.";

                return;
            }


            if (!cilindroOperacion.TaraKg.HasValue ||
                cilindroOperacion.TaraKg.Value <= 0)
            {
                errorMovimiento =
                    "El cilindro no tiene una tara registrada.";

                return;
            }


            var tara =
                cilindroOperacion.TaraKg.Value;


            if (pesoMovimiento <= tara)
            {
                errorMovimiento =
                    $"El peso bruto de despacho debe ser mayor " +
                    $"que la tara del cilindro ({tara:0.##} kg).";

                return;
            }


            var pesoMaximo =
                tara +
                cilindroOperacion.CapacidadKg;


            if (pesoMovimiento > pesoMaximo)
            {
                errorMovimiento =
                    $"El peso bruto de despacho no puede superar " +
                    $"tara + capacidad ({pesoMaximo:0.##} kg).";

                return;
            }
        }


        procesandoMovimiento = true;

        try
        {
            var cilindroId =
                cilindroOperacion.Id;

            var codigoQr =
                cilindroOperacion.CodigoQr;

            var tipoMovimiento =
                esRetorno
                    ? "retorno"
                    : "despacho";


            var datos = new
            {
                ordenTrabajoId =
                    esRetorno
                        ? (int?)null
                        : formularioMovimiento.OrdenTrabajoId,

                responsable =
                    formularioMovimiento.Responsable.Trim(),

                pesoKg =
                    pesoMovimiento,

                observaciones =
                    formularioMovimiento.Observaciones
            };


            using var respuesta =
                await Http.PostAsJsonAsync(
                    $"api/MovimientosInventario/{tipoMovimiento}/{cilindroId}",
                    datos
                );


            if (!respuesta.IsSuccessStatusCode)
            {
                errorMovimiento =
                    await LeerErrorApi(
                        respuesta,
                        "No se pudo registrar el movimiento."
                    );

                return;
            }


            var eraRetorno =
                esRetorno;


            cilindroOperacion = null;

            formularioMovimiento =
                new FormularioMovimiento();


            mensajeExito =
                eraRetorno
                    ? $"El retorno del cilindro {codigoQr} " +
                      "se registró correctamente."
                    : $"El despacho del cilindro {codigoQr} " +
                      "se registró correctamente.";


            await CargarCilindros();
        }
        catch (Exception ex)
        {
            errorMovimiento =
                "Ocurrió un error al registrar el movimiento. " +
                "Comprueba que Afrisan.Api esté ejecutándose.";

            Console.WriteLine(ex);
        }
        finally
        {
            procesandoMovimiento = false;
        }
    }


    // =====================================================
    // ELIMINACIÓN
    // =====================================================

    private void SolicitarEliminacion(int id)
    {
        idPorEliminar = id;

        errorOperacion = null;

        mensajeExito = null;
    }


    private void CancelarEliminacion()
    {
        idPorEliminar = null;
    }


    private async Task EliminarCilindro(int id)
    {
        if (Ocupado ||
            idPorEliminar != id)
        {
            return;
        }


        idEliminando = id;

        errorOperacion = null;

        mensajeExito = null;


        try
        {
            using var respuesta =
                await Http.DeleteAsync(
                    $"api/Cilindros/{id}"
                );


            if (!respuesta.IsSuccessStatusCode)
            {
                errorOperacion =
                    await LeerErrorApi(
                        respuesta,
                        "No se pudo eliminar el cilindro."
                    );

                return;
            }


            idPorEliminar = null;

            mensajeExito =
                "El cilindro se eliminó correctamente.";


            await CargarCilindros();
        }
        catch (Exception ex)
        {
            errorOperacion =
                "Ocurrió un error al eliminar el cilindro.";

            Console.WriteLine(ex);
        }
        finally
        {
            idEliminando = null;
        }
    }


    // =====================================================
    // LEER ERROR API
    // =====================================================

    private static async Task<string> LeerErrorApi(
        HttpResponseMessage respuesta,
        string mensajePredeterminado)
    {
        try
        {
            var contenido =
                await respuesta.Content
                    .ReadAsStringAsync();


            using var documento =
                JsonDocument.Parse(contenido);


            var raiz =
                documento.RootElement;


            if (raiz.ValueKind ==
                JsonValueKind.Object)
            {
                if (raiz.TryGetProperty(
                        "mensaje",
                        out var mensaje) &&
                    mensaje.ValueKind ==
                    JsonValueKind.String)
                {
                    return mensaje.GetString()
                           ?? mensajePredeterminado;
                }


                if (raiz.TryGetProperty(
                        "errors",
                        out var errores) &&
                    errores.ValueKind ==
                    JsonValueKind.Object)
                {
                    foreach (
                        var campo
                        in errores.EnumerateObject())
                    {
                        if (campo.Value.ValueKind ==
                            JsonValueKind.Array)
                        {
                            foreach (
                                var errorCampo
                                in campo.Value.EnumerateArray())
                            {
                                if (errorCampo.ValueKind ==
                                    JsonValueKind.String)
                                {
                                    return errorCampo.GetString()
                                           ?? mensajePredeterminado;
                                }
                            }
                        }
                    }
                }
            }
        }
        catch
        {
        }


        return $"{mensajePredeterminado} " +
               $"Código HTTP: {(int)respuesta.StatusCode}.";
    }


