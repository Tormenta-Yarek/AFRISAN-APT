<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <a class="navbar-brand fw-bold" href="">
            ❄ AFRISAN
        </a>

        <button title="Mostrar menú"
                class="navbar-toggler"
                @onclick="ToggleNavMenu">

            <span class="navbar-toggler-icon"></span>

        </button>

    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable"
     @onclick="ToggleNavMenu">

    <nav class="flex-column">

        <!-- =====================================================
             PANEL PRINCIPAL
             TODOS LOS USUARIOS
             ===================================================== -->

        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">

                <span aria-hidden="true">🏠</span>
                Panel principal

            </NavLink>

        </div>

        <!-- =====================================================
             ADMINISTRADOR Y BODEGA
             ===================================================== -->

        <AuthorizeView Roles="Administrador,Bodega">

            <Authorized>

                <!-- GESTIÓN DE CILINDROS -->
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="cilindros">

                        <span aria-hidden="true">📦</span>
                        Gestión de cilindros

                    </NavLink>

                </div>

                <!-- GASES REFRIGERANTES -->
                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="gases-refrigerantes">

                        <span aria-hidden="true">❄️</span>
                        Gases refrigerantes

                    </NavLink>

                </div>

            </Authorized>

        </AuthorizeView>

        <!-- =====================================================
             IDENTIFICACIÓN QR
             TODOS LOS ROLES
             ===================================================== -->

        <AuthorizeView Roles="Administrador,Jefatura,Bodega,Tecnico">

            <Authorized>

                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="identificacion-qr">

                        <span aria-hidden="true">📱</span>
                        Identificación QR

                    </NavLink>

                </div>

            </Authorized>

        </AuthorizeView>

        <!-- =====================================================
             ADMINISTRADOR
             ===================================================== -->

        <AuthorizeView Roles="Administrador">

            <Authorized>

                <div class="nav-item px-3">

                    <span class="nav-link text-light opacity-75">
                        👥 Administración
                    </span>

                </div>

            </Authorized>

        </AuthorizeView>

        <!-- =====================================================
             JEFATURA
             ===================================================== -->

        <AuthorizeView Roles="Jefatura">

            <Authorized>

                <div class="nav-item px-3">

                    <span class="nav-link text-light opacity-75">
                        📊 Supervisión
                    </span>

                </div>

            </Authorized>

        </AuthorizeView>

        <!-- =====================================================
             TÉCNICO
             ===================================================== -->

        <AuthorizeView Roles="Tecnico">

            <Authorized>

                <div class="nav-item px-3">

                    <span class="nav-link text-light opacity-75">
                        🛠️ Funciones de terreno
                    </span>

                </div>

            </Authorized>

        </AuthorizeView>

    </nav>

</div>

@code {

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}